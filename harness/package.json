  "description": "Falsification harness for P1 (repeat-presentation unlinkability) of a BBS-based guardianship-delegation credential.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
